{
  "name": "@todo-platform/user-service",
  "version": "1.0.0",
  "description": "User service for todo-platform-eks",
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node --watch dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run typecheck && c8 node --test -r ts-node/register \"test/**/*.test.ts\""
  },
  "dependencies": {
    "close-with-grace": "^2.5.0",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2"
  },
  "private": true
}
